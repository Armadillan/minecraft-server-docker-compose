# Minecraft Server (Paper) — Environment Variables
# Copy this file to `.env` and fill in the required value before
# `docker compose up`. `.env` is gitignored — never commit real credentials.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull`
# delivers the version combination this repository has tested. To pin a
# different version yourself, uncomment and set:
# MINECRAFT_SERVER_IMAGE_TAG=itzg/minecraft-server:2026.9.0@sha256:…
# MINECRAFT_SERVER_BACKUP_IMAGE_TAG=itzg/mc-backup:2026.9.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────────────────

# RCON admin password. REQUIRED — generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
MINECRAFT_SERVER_RCON_PASSWORD=change_me_before_first_start

# ──────────────────────────────────────────────────────────────────────────────
# Game settings (compose-level defaults shown; override only to diverge)
# ──────────────────────────────────────────────────────────────────────────────

# By keeping EULA=true you accept the Minecraft EULA
# (https://www.minecraft.net/eula). The server refuses to start otherwise.
# MINECRAFT_SERVER_EULA=true

# MINECRAFT_SERVER_TYPE=PAPER
# MINECRAFT_SERVER_VERSION=LATEST
# MINECRAFT_SERVER_MEMORY=2G
# MINECRAFT_SERVER_SERVER_NAME=Minecraft Server
# MINECRAFT_SERVER_MOTD=heyvaldemar.com - IT Guides by Docker Captain
# MINECRAFT_SERVER_MODE=survival
# MINECRAFT_SERVER_DIFFICULTY=normal
# MINECRAFT_SERVER_MAX_PLAYERS=20
# MINECRAFT_SERVER_PVP=true
# MINECRAFT_SERVER_ONLINE_MODE=true
# MINECRAFT_SERVER_VIEW_DISTANCE=10
# MINECRAFT_SERVER_LEVEL=minecraft-world-1
# MINECRAFT_SERVER_LEVEL_TYPE=normal
# MINECRAFT_SERVER_SERVER_PORT=25565
# MINECRAFT_SERVER_RCON_PORT=25575
# MINECRAFT_SERVER_WHITELIST=
# MINECRAFT_SERVER_OPS=
# MINECRAFT_SERVER_SERVER_TIMEZONE=UTC

# Plugins installed automatically on start:
# MINECRAFT_SERVER_MODRINTH_PROJECTS=viaversion,viabackwards,skinsrestorer
# MINECRAFT_SERVER_PLUGINS=https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/spigot

# ──────────────────────────────────────────────────────────────────────────────
# Scale-to-zero (mc-router)
# ──────────────────────────────────────────────────────────────────────────────

# The hostname players type into the client's "Add Server" box. The router
# routes it to the server container, wakes the server on first join, and
# stops it again after the idle timeout below. Comma-separated for several.
# Until you set a real one, the default placeholder routes nothing: the
# router refuses every connection and the server never wakes.
# MINECRAFT_SERVER_ROUTER_HOST=mc.example.com

# Wake on join / sleep after idle (defaults shown; override only to diverge)
# MINECRAFT_SERVER_ROUTER_AUTO_SCALE_UP=true
# MINECRAFT_SERVER_ROUTER_AUTO_SCALE_DOWN=true
# MINECRAFT_SERVER_ROUTER_AUTO_SCALE_DOWN_AFTER=2h
# MINECRAFT_SERVER_ROUTER_AUTO_SCALE_ASLEEP_MOTD=Server is asleep. Join again to wake it up!
# MINECRAFT_SERVER_ROUTER_AUTO_SCALE_LOADING_MOTD=Server is waking up, hold on

# The router reaches the Docker daemon through the socket-proxy container,
# which is the only one holding /var/run/docker.sock - nothing to configure
# here. Its allow-list (the least this stack needs) is in the compose file:
# CONTAINERS, POST=0, ALLOW_START, ALLOW_STOP, ALLOW_UNPAUSE.

# Socket proxy resource limits (defaults shown)
# MINECRAFT_SERVER_SOCKET_PROXY_MEMORY_LIMIT=32m
# MINECRAFT_SERVER_SOCKET_PROXY_CPU_LIMIT=0.25
# MINECRAFT_SERVER_SOCKET_PROXY_MEMORY_RESERVATION=8m
# MINECRAFT_SERVER_SOCKET_PROXY_CPU_RESERVATION=0.05

# Router resource limits (defaults shown)
# MINECRAFT_SERVER_ROUTER_MEMORY_LIMIT=64m
# MINECRAFT_SERVER_ROUTER_CPU_LIMIT=0.25
# MINECRAFT_SERVER_ROUTER_MEMORY_RESERVATION=16m
# MINECRAFT_SERVER_ROUTER_CPU_RESERVATION=0.05

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# MINECRAFT_SERVER_BACKUP_INTERVAL=23h
# Set far out on purpose: the backup-watcher enforces the joint retention
# policy (2 per day x 3 days) across both backup triggers, so this is a
# safety net only.
# MINECRAFT_SERVER_PRUNE_BACKUPS_DAYS=3650
# MINECRAFT_SERVER_INITIAL_DELAY=0
# Back up at a fixed time instead of every interval after the sidecar starts,
# in the zone set by MINECRAFT_SERVER_SERVER_TIMEZONE. When set, the interval and
# the initial delay above are ignored. Leave it commented out rather than empty:
# an empty value still switches mc-backup to cron, with no schedule.
# With scale-to-zero the window only lands while the server is awake: the
# sidecar flushes the world over RCON, and a stopped server refuses it, so an
# asleep window is skipped. Point it at a time your players are usually online.
# CRON_SCHEDULE=0 4 * * *
# BACKUP_METHOD=tar

# Shutdown backup + joint retention (the backup-watcher service). When the
# router scales the server down, the watcher tars the just-flushed world -
# the scheduled backup cannot, because RCON is gone with the server. Both
# triggers' archives share one retention policy:
# MINECRAFT_SERVER_BACKUP_WATCHER_MAX_PER_DAY=2
# MINECRAFT_SERVER_BACKUP_WATCHER_MAX_DAYS=3
# MINECRAFT_SERVER_BACKUP_WATCHER_POLL_INTERVAL=60

# Watcher resource limits (defaults shown)
# MINECRAFT_SERVER_BACKUP_WATCHER_MEMORY_LIMIT=128m
# MINECRAFT_SERVER_BACKUP_WATCHER_CPU_LIMIT=0.5
# MINECRAFT_SERVER_BACKUP_WATCHER_MEMORY_RESERVATION=16m
# MINECRAFT_SERVER_BACKUP_WATCHER_CPU_RESERVATION=0.1

# ──────────────────────────────────────────────────────────────────────────────
# Admin panel (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# The UI's port on the host, bound to 127.0.0.1 only. From another machine,
# reach it with an SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 user@your-host
# MINECRAFT_SERVER_ADMIN_PANEL_PORT=8080

# Optional shared token for the UI and its API. When set, the page asks for
# it once (kept in the browser session) and every request must carry it in
# the X-Panel-Token header. The panel executes in-game commands, so set one
# if you will ever tunnel to it from a machine you do not fully control.
# MINECRAFT_SERVER_ADMIN_PANEL_TOKEN=

# Panel resource limits (defaults shown)
# MINECRAFT_SERVER_ADMIN_PANEL_MEMORY_LIMIT=96m
# MINECRAFT_SERVER_ADMIN_PANEL_CPU_LIMIT=0.25
# MINECRAFT_SERVER_ADMIN_PANEL_MEMORY_RESERVATION=32m
# MINECRAFT_SERVER_ADMIN_PANEL_CPU_RESERVATION=0.05

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# MINECRAFT_SERVER_MEMORY_LIMIT=2g
# MINECRAFT_SERVER_CPU_LIMIT=2.0
# MINECRAFT_SERVER_MEMORY_RESERVATION=256m
# MINECRAFT_SERVER_CPU_RESERVATION=0.5
# MINECRAFT_SERVER_BACKUPS_MEMORY_LIMIT=256m
# MINECRAFT_SERVER_BACKUPS_CPU_LIMIT=0.5
# MINECRAFT_SERVER_BACKUPS_MEMORY_RESERVATION=32m
# MINECRAFT_SERVER_BACKUPS_CPU_RESERVATION=0.1

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# MINECRAFT_SERVER_IMAGE_VERSION=2026.10.0
# MINECRAFT_SERVER_BACKUP_IMAGE_VERSION=2026.10.1
# MINECRAFT_SERVER_ROUTER_IMAGE_VERSION=1.49.0
# MINECRAFT_SERVER_SOCKET_PROXY_IMAGE_VERSION=version-3.4.7-r0
# MINECRAFT_SERVER_BACKUP_WATCHER_IMAGE_VERSION=1.38.0
# MINECRAFT_SERVER_ADMIN_PANEL_IMAGE_VERSION=3.13-slim
